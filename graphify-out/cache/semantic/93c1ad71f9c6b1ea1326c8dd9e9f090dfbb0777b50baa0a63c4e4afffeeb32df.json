{"nodes": [{"id": "theme_brief", "label": "Avaris theme and services-page brief", "file_type": "document", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agreed colors, typography, motion, lens-control placement and scope recorded before implementation."}, {"id": "theme_scope", "label": "Milestone scope", "file_type": "rationale", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the approved homepage including desktop camera composition and mobile side margins; add one lens-inspired homepage control and one new Services page. No other pages, backend, CMS or contact form in this milestone."}, {"id": "theme_visual_direction", "label": "Established visual direction", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cinematic, minimal, dark studio atmosphere with the camera as the homepage main attraction."}, {"id": "theme_onyx", "label": "Onyx base token #0A0A0A", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "theme_blue_slate", "label": "Blue Slate token #536878", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for cool light, subdued surfaces and reflections."}, {"id": "theme_alabaster", "label": "Alabaster token #E5E4E2", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary text and highlights."}, {"id": "theme_burgundy", "label": "Burgundy accent token #7B1D36", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted reference accent for restrained emphasis."}, {"id": "theme_focus_burgundy", "label": "Burgundy focus token #9B2946", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for focus rings and button outlines."}, {"id": "theme_montserrat_black", "label": "Montserrat Black 900 display typography", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uppercase and tightly spaced for display headlines."}, {"id": "theme_dm_sans", "label": "DM Sans navigation, label and body typography", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Body copy starts at 16 px."}, {"id": "theme_motion", "label": "Live smoke, fluid wakes and ribbon motion guidance", "file_type": "rationale", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live drifting and billowing smoke, small cursor-sized fluid wakes and gently moving burgundy ribbons. Keep smoke behind content, respect reduced-motion preferences and pause background work in hidden tabs."}, {"id": "theme_avoid_list", "label": "Excluded styling patterns", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid bright palettes, purple, generic dashboard styling, excessive cards, unnecessary icons and invented business statistics."}, {"id": "theme_lens_control_spec", "label": "Homepage services button specification", "file_type": "rationale", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Label Explore services. Compact camera-lens control with concentric focus rings, subtle dial markings, dark glass, aperture detail and muted burgundy focus glow; must look clickable, keep text legible, have keyboard focus styling and restrained hover/focus ring motion."}, {"id": "theme_lens_placement", "label": "Lens control placement rule", "file_type": "rationale", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop: open lower-left area beside the camera, aligned near the logo left inset, avoiding the camera monitor below the headline. Mobile: centered between headline and camera while preserving approved camera width and bottom anchoring."}, {"id": "theme_services_destination", "label": "Services destination route /services/", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be a real separate page that works on direct load and refresh."}, {"id": "theme_services_page_spec", "label": "Services page specification", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same studio background, live smoke, burgundy ribbons, colors and typography; minimal header with Avaris home link and Contact control."}, {"id": "theme_services_headline", "label": "Your business. Our full focus.", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opening headline of the Services page."}, {"id": "theme_editorial_list", "label": "Editorial expandable list format", "file_type": "rationale", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Services presented as an editorial list with expandable details rather than a grid of generic cards."}, {"id": "theme_service_websites", "label": "Websites and digital experiences service group", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business websites, landing pages, e-commerce and ongoing website care."}, {"id": "theme_service_strategy", "label": "Digital strategy and campaigns service group", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planning, campaign direction and marketing coordination."}, {"id": "theme_service_social", "label": "Social media and content service group", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content planning, copywriting, social creative and channel management."}, {"id": "theme_service_video", "label": "Video and photography service group", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Video shoots, brand films, product photography, reels and post-production."}, {"id": "theme_service_search", "label": "Search and paid media service group", "file_type": "concept", "source_file": "THEME.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SEO, local visibility, search ads, social ads and campaign reporting."}, {"id": "theme_service_branding", "label": "Branding and design service group", "file_type": "concept", "source_file": "TH