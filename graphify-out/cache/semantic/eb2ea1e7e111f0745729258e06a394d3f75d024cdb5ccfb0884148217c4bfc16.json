ncept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the frozen ribbons of the retained design-reference background with animated vector ribbons."}, {"id": "readme_live_smoke", "label": "Continuously evolving procedural smoke (2D GPU effect)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Crosswind, lift and changing eddies remain active while the pointer is idle; background loops pause on hidden pages."}, {"id": "readme_hero_camera_replacement", "label": "HeroCamera.tsx foreground replacement point", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designated swap point for the final 3D model; background and atmosphere are separate layers and can stay intact."}, {"id": "readme_studio_atmosphere", "label": "StudioAtmosphere ribbon morphing at 16 and 19 seconds", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "readme_live_smoke_renderer", "label": "LiveSmokeRenderer domain-warped shader noise", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visible Canvas layer is capped at 1000 pixels wide."}, {"id": "readme_canvas_fallback", "label": "Moving procedural Canvas fallback", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers devices without a usable shader context."}, {"id": "readme_fluid_wake", "label": "InteractiveSmoke and FluidWake velocity/dye